# Public browser configuration. The anon key is intentionally safe to expose;
# never put the Supabase service-role key or Stripe secret keys in VITE_* vars.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# E2E_BASE_URL=https://dev.example.com
# E2E_TEST_EMAIL=dedicated-staging-family@example.com
# E2E_TEST_PASSWORD=use-a-secret-in-CI-not-this-file
# E2E_STRIPE_TEST=0
