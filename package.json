{
  "name": "foundational-minds-modules",
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive learning modules with Supabase integration",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build:module-css": "tailwindcss -c tailwind.module.config.js -i styles/module-tailwind.src.css -o styles/module-tailwind.css --minify",
    "prebuild": "npm run build:module-css",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "optimize:characters": "node scripts/optimize-character-assets.mjs",
    "verify:production": "node --env-file-if-exists=.env.local scripts/verify-production.mjs",
    "build:all": "npm run build && node scripts/build-sidecar.mjs",
    "build:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@stripe/stripe-js": "^8.6.0",
    "@supabase/supabase-js": "^2.110.8",
    "@twemoji/api": "^17.0.3",
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "dotenv": "^17.2.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.5"
  }
}
